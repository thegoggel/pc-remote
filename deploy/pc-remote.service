[Unit]
Description=PC Remote wake, Steam, and shutdown
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pc-remote
Group=pc-remote
WorkingDirectory=/opt/pc-remote
EnvironmentFile=/etc/pc-remote.env
ExecStart=/usr/bin/python3 -m app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
