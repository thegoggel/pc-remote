# Copy to /etc/pc-remote.env on the LXC and fill in real values.
# Do not commit that file.

# Cloudflare hostname, no path and no trailing slash.
# https makes the session cookie Secure. Use http only for localhost.
PUBLIC_URL=https://wake.example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account that may use the page. Comma-separated if you add another.
ALLOWED_EMAIL=you@gmail.com

# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=wol
MIKROTIK_PASSWORD=
# Interface the router uses for /tool wol (often bridge).
MIKROTIK_INTERFACE=bridge
# MIKROTIK_PORT=8728

PC_MAC=AA:BB:CC:DD:EE:FF
PC_ADDRESS=192.168.88.50

# POST /start on the LAN listener. Turn off uses the same host and port at /shutdown.
LISTENER_URL=http://192.168.88.50:8765/start
# Same value as ListenerSecret in the Windows config.ps1.
LISTENER_SECRET=

# The app listens here. cloudflared on this LXC should be the only client.
# BIND_HOST=127.0.0.1
# BIND_PORT=8080
# WAKE_TIMEOUT_SECONDS=180
